{
  "name": "hermes-game-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test:build": "node scripts/verify-build.mjs",
    "test:unit": "vitest run",
    "test:game": "node scripts/verify-game.mjs",
    "verify": "npm run check && npm run test:unit && npm run build && npm run test:build && npm run test:game",
    "preview": "vite preview"
  },
  "devDependencies": {
    "playwright": "^1.61.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
